# ── Base de données (Supabase) ─────────────────────────────────────────────────
# Pooler pgbouncer (port 6543) — utilisé par NestJS en runtime
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Connexion directe (port 5432) — Prisma migrations uniquement
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production

# ── NestJS ─────────────────────────────────────────────────────────────────────
API_PORT=3001
# URL interne de NestJS pour le rewrite /api/* de Next.js (dev).
# En prod AWS, Caddy route /api/* directement vers NestJS (voir infra/aws/README.md).
BACKEND_URL=http://localhost:3001

# ── CORS ───────────────────────────────────────────────────────────────────────
# URL publique vue par le navigateur (Next.js, port 3000 en dev).
# Vide = toutes les origines autorisées (dev uniquement).
# Prod : https://atelier.trigenys.com (ou http://IP avant le domaine).
ALLOWED_ORIGINS=http://localhost:3000

# ── Production AWS uniquement (Caddy) ──────────────────────────────────────────
# Domaine public + e-mail Let's Encrypt. Vides en local. En prod : SSM.
APP_DOMAIN=
ACME_EMAIL=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Formulaire démo (/demo) — notification in-app aux comptes SUPER_ADMIN ───
# (aucune variable requise — utilise le module notifications)

# ── Inscription publique (/inscription) ───────────────────────────────────────
PUBLIC_SIGNUP_ENABLED=true
# Limitation de débit (src/shared/security/rate-limits.ts). false = désactivée,
# uniquement pour des tests locaux (ex. collections Postman). Jamais en production.
RATE_LIMIT_ENABLED=true
# true = autoriser même si un ADMIN existe déjà (tests locaux avec seed)
SIGNUP_ALLOW_IF_ADMIN_EXISTS=false

# ── E-mail de bienvenue après inscription (Resend) ─────────────────────────────
# Sans RESEND_API_KEY : aucun e-mail envoyé (simple avertissement dans les logs).
# Clé « Sending access » limitée au domaine vérifié chez Resend. En prod : SSM.
RESEND_API_KEY=
SIGNUP_EMAIL_FROM=Atelier Maître <ateliermaitre@trigenys.com>
# Invitations d'équipe (lien d'activation 72 h) : même clé Resend. Expéditeur facultatif,
# par défaut SIGNUP_EMAIL_FROM. Sans APP_PUBLIC_URL/APP_DOMAIN, aucune invitation ne part.
TEAM_INVITE_EMAIL_FROM=
# Facultatif : adresse de réponse (par défaut, celle de l'expéditeur)
SIGNUP_EMAIL_REPLY_TO=
# URL publique pour les liens et le logo de l'e-mail (sinon déduite de APP_DOMAIN)
APP_PUBLIC_URL=

# -- Paiements d'abonnement -------------------------------------------------
# Prestataire des NOUVEAUX checkouts (defaut notchpay). Valeur inconnue = l'API refuse de demarrer.
# Les paiements en cours d'un ancien prestataire restent verifies tant que son adaptateur est enregistre.
PAYMENT_PROVIDER=notchpay

# -- NotchPay -----------------------------------------------------------------
# test par defaut ; passer explicitement a live apres validation Sandbox.
NOTCHPAY_MODE=test
NOTCHPAY_TEST_PUBLIC_KEY=pk_test_...
NOTCHPAY_TEST_WEBHOOK_HASH=hsk_test_...
NOTCHPAY_LIVE_PUBLIC_KEY=pk_live_...
NOTCHPAY_LIVE_WEBHOOK_HASH=hsk_live_...
# URL officielle par defaut ; surcharge utile uniquement pour les tests locaux.
NOTCHPAY_API_URL=https://api.notchpay.co

# ── Messagerie SMS / WhatsApp (MessagingModule) ───────────────────────────────
# Fournisseur choisi au démarrage. Seule valeur disponible : simulator (aucun
# message ne part). Valeur inconnue → l'API refuse de démarrer (fail-fast).
# Les fournisseurs réels (Techsoft #19, SmsPro #20) liront leurs propres secrets
# ici ; en prod, uniquement via SSM — jamais dans le frontend ni dans GitHub.
SMS_PROVIDER=simulator
# SMS.to : SMS_PROVIDER=smsto + SMSTO_API_KEY (obligatoire, SSM en prod).
# SMSTO_SENDER_ID : expéditeur alphanumérique (1-11 car., défaut AtelierMtr).
# SMSTO_API_KEY=
# SMSTO_SENDER_ID=AtelierMtr
# Unimatrix : SMS_PROVIDER=unimtx + UNIMTX_ACCESS_KEY_ID (obligatoire, SSM en prod).
# UNIMTX_SENDER_ID : 2-16 car. (lettres, chiffres, espace, "-", "_" ; défaut AtelierM).
# UNIMTX_ACCESS_KEY_ID=
# UNIMTX_SENDER_ID=AtelierM
# WhatsApp Cloud API (Meta) : WHATSAPP_PROVIDER=whatsapp-cloud + WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID (SSM en prod).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v25.0
# Webhook Meta (GET|POST /api/webhooks/whatsapp) : les deux ensemble ou aucun (absents = route 404).
# VERIFY_TOKEN : valeur aléatoire choisie par nous, recopiée dans Meta for Developers (openssl rand -hex 32).
# APP_SECRET : « Clé secrète de l'application » Meta (Paramètres > Général), signe X-Hub-Signature-256.
# Différents de WHATSAPP_ACCESS_TOKEN. SSM en prod, jamais dans le dépôt.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
WHATSAPP_PROVIDER=simulator
# Destinataires autorisés pour POST /api/notifications/whatsapp/test (SUPER_ADMIN), E.164 séparés par des virgules.
# Vide = aucun envoi de test possible.
# WHATSAPP_TEST_RECIPIENTS=

# Notifications client automatiques (WhatsApp) — docs/architecture/notifications-client.md.
# off (défaut, aucun envoi) | sandbox (WHATSAPP_TEST_RECIPIENTS seulement) | live (clients réels).
# Valeur inconnue = l'API refuse de démarrer. live exige WHATSAPP_PROVIDER=whatsapp-cloud,
# au moins un modèle approuvé et un plafond explicite.
CUSTOMER_NOTIFICATIONS_MODE=off
# Modèles approuvés chez Meta, nom:langue séparés par des virgules.
# WHATSAPP_APPROVED_TEMPLATES=am_vehicle_ready_v1:fr,am_appointment_confirmed_v1:fr
# Plafond mensuel de messages par garage (défaut 300).
# CUSTOMER_NOTIFICATIONS_MONTHLY_CAP=300
# Repli SMS : seul "off" est accepté pour l'instant.
# CUSTOMER_NOTIFICATIONS_SMS_FALLBACK=off
