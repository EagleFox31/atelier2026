            "item": [
                {
                    "name": "1.1 Login Conseiller",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Login reussi\", function () { pm.response.to.have.status(200); });",
                                    "var jsonData = pm.response.json();",
                                    "if(jsonData.access_token) pm.collectionVariables.set(\"advisorToken\", jsonData.access_token);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\"identifier\":\"reception@atelier.cm\", \"password\":\"Atelier2026!\"}"
                        }
