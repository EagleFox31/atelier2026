# Exemple — copier en terraform.tfvars (ne pas committer)

compartment_id = "ocid1.tenancy.oc1..aaaaaaaaxxxxx"
region         = "eu-paris-1"
ssh_public_key = "ssh-ed25519 AAAA... user@machine"

# IMPORTANT : restreindre SSH a votre IP (https://ifconfig.me)
admin_cidr = "203.0.113.10/32"

# Si erreur "Out of host capacity" sur Ampere A1 :
# availability_domain = "xxxxx:EU-PARIS-1-AD-2"
