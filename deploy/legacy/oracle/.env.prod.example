# Copier vers deploy/.env.prod et remplir les valeurs

# ══════════════════════════════════════════════════════════════════════════════
# Mode A — PostgreSQL sur le même serveur (UpCloud trial, sans Supabase distant)
# Au 1er démarrage API : db push + full_schema.sql (triggers, audit_logs partitions, vues)
# ══════════════════════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=choisir_un_mot_de_passe_fort

DATABASE_URL=postgresql://atelier:choisir_un_mot_de_passe_fort@postgres:5432/atelier
DIRECT_URL=postgresql://atelier:choisir_un_mot_de_passe_fort@postgres:5432/atelier

# ══════════════════════════════════════════════════════════════════════════════
# Mode B — Supabase (décommenter et remplacer Mode A ; firewall sortant 5432/6543 requis)
# ══════════════════════════════════════════════════════════════════════════════
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth (obligatoire — generer un secret fort) ────────────────────────────────
JWT_SECRET=remplacer_par_openssl_rand_hex_64

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://VOTRE_IP_PUBLIQUE

# ── Domaine (optionnel — HTTPS Caddy) ────────────────────────────────────────
APP_DOMAIN=
ACME_EMAIL=contact@atelier2026.cm

# ── Redis (inclus dans docker-compose — ne pas changer) ──────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── NestJS ───────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production

# ── Formulaire démo (/demo) → notification in-app SUPER_ADMIN (pas d'email SMTP)
