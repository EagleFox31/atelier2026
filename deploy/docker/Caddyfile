{
	email {$ACME_EMAIL:admin@example.com}
}

# Si APP_DOMAIN est défini → HTTPS auto Let's Encrypt + redirect HTTP→HTTPS
# Sinon → HTTP sur port 80 uniquement (fallback IP directe)

{$APP_DOMAIN::80} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
