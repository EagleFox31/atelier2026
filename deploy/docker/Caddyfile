# MVP : HTTP sur le port 80 (IP publique ou domaine)
# /api/* → NestJS | reste → Next.js (meme origine pour le browser)

{
	email {$ACME_EMAIL:admin@example.com}
}

:80 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}

