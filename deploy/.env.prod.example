# Copier vers deploy/.env.prod et remplir les valeurs

# ── Supabase (obligatoire) ─────────────────────────────────────────────────────
# Runtime API : pooler 6543 + pgbouncer
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Migrations au demarrage API : connexion directe 5432 (PAS prisma migrate deploy)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth (obligatoire — generer un secret fort) ────────────────────────────────
JWT_SECRET=remplacer_par_openssl_rand_hex_64

# ── CORS ───────────────────────────────────────────────────────────────────────
# URL publique vue par le browser (IP ou domaine, sans slash final)
# Ex MVP : http://129.146.xxx.xxx
# Ex prod : https://atelier.example.cm
ALLOWED_ORIGINS=http://VOTRE_IP_PUBLIQUE

# ── Domaine (optionnel — HTTPS Caddy) ────────────────────────────────────────
APP_DOMAIN=
ACME_EMAIL=contact@atelier2026.cm

# ── Redis (inclus dans docker-compose — ne pas changer sauf Redis externe) ───
REDIS_HOST=redis
REDIS_PORT=6379

# ── NestJS ───────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production
