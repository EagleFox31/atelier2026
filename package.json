{
  "name": "trigenys-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npx ts-node --project tsconfig.server.json server.ts",
    "dev:next": "next dev --port 3000",
    "type:check": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit",
    "type:check:api": "tsc --noEmit -p tsconfig.server.json",
    "type:check:front": "tsc --noEmit",
    "build": "next build",
    "build:api": "npx prisma generate && tsc -p tsconfig.server.build.json",
    "start": "next start",
    "start:api": "node dist/server.js",
    "lint": "eslint .",
    "clean": "next clean",
    "migrate": "node scripts/migrate-missing.mjs",
    "rotate:jwt": "node scripts/rotate-jwt-secret.mjs",
    "rotate:jwt:dry-run": "node scripts/rotate-jwt-secret.mjs --dry-run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "npx newman run postman/Atelier_2026.postman_collection.json --bail --verbose --environment postman/newman-env.json --export-environment postman/newman-env.json",
    "test:e2e:fresh": "node scripts/reset-test-env.mjs && npm run test:e2e",
    "test:mutation": "stryker run stryker.config.ts",
    "test:mutation:ci": "stryker run stryker.config.ts --reporters progress,clear-text",
    "reset:demo": "node scripts/reset-demo-data.mjs",
    "test:pw": "playwright test",
    "test:pw:ui": "playwright test --ui",
    "test:pw:headed": "playwright test --headed",
    "test:pw:report": "playwright show-report reports/playwright"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.74.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.8.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-themes": "^0.4.6",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.23",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "jest": "^30.4.2",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "tailwindcss": "4.1.11",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
